{
  "manifest_version": 3,
  "name": "JobMonkey",
  "version": "1.0",
  "permissions": ["storage"],
  "options_page": "options.html",
  "content_scripts": [
    {
      "js": ["content/dice.js"],
      "matches": ["https://www.dice.com/*"]
    },
    {
      "js": ["content/linkedin.js"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ]
}
